#!/usr/bin/env python3
"""
Verify the data contract, then auto-bump patch version on every commit.

**Tracked in the repo, not in .git/hooks** — `.git/hooks` is not cloned, so a
dev checkout would silently get neither half of this: `main` would start
collecting `"version": "pending"` changelog entries and unverified data-contract
changes. Both checkouts point here with:

    git config core.hooksPath build/hooks

Note that setting `core.hooksPath` replaces the hooks directory wholesale, so
any other hook has to live here too rather than in `.git/hooks`.

- Run build/smoke_test.py (skipped, with a notice, where the data directory
  doesn't exist); abort the commit if a page reads a column or file
  that no longer exists, or if the rulebook's 🔒/👁 enforcement badges have
  drifted from what nbn-api's validators actually check
  (build/check_rulebook_badges.py --fix rewrites them). Bypass with
  `git commit --no-verify` if needed.
- Run build/test_build_sh.py; abort if build.sh has stopped defaulting to the
  Python stats engine, or grown a second copy of the season rule.
- Run build/test_validate_boxscore.py; abort if the box score validator has
  stopped catching a moved column or a TOTALS mismatch. Those two failures put
  plausible numbers in the wrong fields of an append-only file, so nothing
  downstream would ever report them.
- Run build/test_parse_night_reread.py; abort if a fresh re-read could change
  a cell the printed totals (or a split between two reads) don't prove.
- Run build/test_parse_night_compare.py; abort if the double read has stopped
  naming a cell its two transcriptions disagree on.
- Run every tests/*.test.js (pure node: cap health, lineup, clinch, NBA Cup,
  my-team, power rank, advanced stats, award race, injuries, feed headlines,
  redirects). Each file's header says what it pins. No browser and no network,
  unlike tests/frontend/run.js, which stays out of the hook for exactly those
  reasons. Skipped where node isn't installed.
- Run build/test_achievement_inputs.js; abort if the NB¥ achievement awarder can
  no longer read the data it scores from. That job runs on a 10-minute timer with
  no output but its own journal, so when its inputs moved out of the repo it
  failed silently for six weeks and awarded nothing. Needs the data directory,
  like smoke_test.py; skipped where node isn't installed.
- Run build/check_dup_helpers.py; abort if a page defines its own copy of a
  helper nbn-data.js provides (escaper, CSV parser, team map) beyond the
  baseline, or uses NBN.* without loading /nbn-data.js.
- Run build/og_tags.py --check; abort if any page has missing or stale link-preview
  tags. New pages are the case this catches: without it they ship with no Discord
  unfurl and nothing says so.
- Run build/head_preloads.py --check; abort if a page that loads theme-boot.js
  lacks the static NBN:preload block, or carries a stale one, so a new page
  starts its stylesheets and fonts as early as the rest.
- Run build/check_design_drift.py; abort if any file gained a literal font
  size, colour, radius, gradient, shadow, emoji or bare .page container
  against build/design-drift-baseline.json. A ratchet: counts only go down.
- Run build/make_ui_icons.py --check; abort if css/ui-icons.css (generated)
  no longer matches the icons drawn in the script.
- If no changelog entry is pending, nothing user-facing shipped: skip the bump
  entirely. A docs-only commit used to advertise a version /changelog had no
  entry for.
- If version.json is staged AND differs from HEAD (a real manual minor/major
  bump), leave it alone. Staged-but-unchanged is not a manual bump — treating it
  as one stamped the new entry with the version that already shipped, and the
  changelog came out with two 0.1.81 entries.
- Otherwise, increment the patch digit and stage version.json.
- Fill in *every* pending entry, not just the top one. A commit that adds two
  entries used to leave the second "pending" forever; five entries were stuck
  that way before this was fixed.
"""
import json, os, shutil, subprocess, sys
from pathlib import Path

# The two checks that read the data directory (smoke_test.py and the
# achievement inputs) can only run where it exists: on the box. A checkout
# anywhere else (a cloud session, a laptop) skips them, loudly, rather than
# failing every commit or pushing people to --no-verify past the whole hook.
DATA_DIR = Path(os.environ.get('NBS_DATA_DIR', '/var/lib/nothing-but-stats'))
HAVE_DATA = (DATA_DIR / 'derived').is_dir()
if not HAVE_DATA:
    print(f'pre-commit: no data directory at {DATA_DIR}, so the data-contract smoke test '
          'and the achievement-inputs check are SKIPPED. They run on the box.')

smoke = Path('build/smoke_test.py')
if smoke.exists() and HAVE_DATA:
    result = subprocess.run(['python3', str(smoke), '--quiet'])
    if result.returncode != 0:
        print('\nCommit aborted: the data contract is broken (see FAIL lines above).')
        print('Fix the mismatch, or bypass with: git commit --no-verify')
        sys.exit(1)

build_sh_test = Path('build/test_build_sh.py')
if build_sh_test.exists():
    result = subprocess.run(['python3', str(build_sh_test)])
    if result.returncode != 0:
        print('\nCommit aborted: build.sh no longer holds its contract (see FAIL lines above).')
        print('Fix it, or bypass with: git commit --no-verify')
        sys.exit(1)

box_test = Path('build/test_validate_boxscore.py')
if box_test.exists():
    result = subprocess.run(['python3', str(box_test)])
    if result.returncode != 0:
        print('\nCommit aborted: the box score validator no longer catches what it must.')
        print('Fix build/validate_boxscore.py, or bypass with: git commit --no-verify')
        sys.exit(1)

reread_test = Path('build/test_parse_night_reread.py')
if reread_test.exists():
    result = subprocess.run(['python3', str(reread_test)], stdout=subprocess.DEVNULL)
    if result.returncode != 0:
        print('\nCommit aborted: parse_night.py reread would settle a column the screen does not prove.')
        print('Fix build/parse_night.py, or bypass with: git commit --no-verify')
        sys.exit(1)

compare_test = Path('build/test_parse_night_compare.py')
if compare_test.exists():
    result = subprocess.run(['python3', str(compare_test)], stdout=subprocess.DEVNULL)
    if result.returncode != 0:
        print('\nCommit aborted: parse_night.py compare no longer catches a split double read.')
        print('Fix build/parse_night.py, or bypass with: git commit --no-verify')
        sys.exit(1)

# Every pure-node unit test under tests/ (cap health, lineup, clinch, NBA Cup,
# my-team, power rank, advanced stats, award race, injuries, feed headlines,
# redirects, ...). No browser, no network, so they belong between a commit and
# its author; tests/frontend/ does not, and is not matched. A new
# tests/*.test.js runs here with no edit to this file. Skipped where node
# isn't installed rather than making node a requirement for committing.
if shutil.which('node'):
    for unit in sorted(Path('tests').glob('*.test.js')):
        result = subprocess.run(['node', str(unit)], capture_output=True, text=True)
        if result.returncode != 0:
            print(result.stdout, result.stderr)
            print(f'\nCommit aborted: {unit} failed (see above).')
            print('Fix it, or bypass with: git commit --no-verify')
            sys.exit(1)

ach_inputs = Path('build/test_achievement_inputs.js')
if ach_inputs.exists() and shutil.which('node') and HAVE_DATA:
    result = subprocess.run(['node', str(ach_inputs)], capture_output=True, text=True)
    if result.returncode != 0:
        print(result.stdout)
        print('\nCommit aborted: the achievement awarder can no longer read its inputs.')
        print('Fix INPUTS in build/achievement-notify.js, or bypass with: git commit --no-verify')
        sys.exit(1)

dup = Path('build/check_dup_helpers.py')
if dup.exists():
    result = subprocess.run(['python3', str(dup)])
    if result.returncode != 0:
        print('\nCommit aborted: a shared helper was copied into a page again, or a page')
        print('uses NBN.* without loading /nbn-data.js (see above).')
        sys.exit(1)

og_tags = Path('build/og_tags.py')
if og_tags.exists():
    result = subprocess.run(['python3', str(og_tags), '--check'])
    if result.returncode != 0:
        print('\nCommit aborted: link-preview tags are missing or stale.')
        print('Add the page to PAGES in build/og_tags.py, then run: python3 build/og_tags.py')
        sys.exit(1)

head_preloads = Path('build/head_preloads.py')
if head_preloads.exists():
    result = subprocess.run(['python3', str(head_preloads), '--check'])
    if result.returncode != 0:
        print('\nCommit aborted: a page is missing its stylesheet/font preloads, or has stale ones.')
        print('Run: python3 build/head_preloads.py')
        sys.exit(1)

design_drift = Path('build/check_design_drift.py')
if design_drift.exists():
    result = subprocess.run(['python3', str(design_drift)])
    if result.returncode != 0:
        print('\nCommit aborted: a page added literal sizes, colours, radii, gradients, shadows or emoji.')
        print('Use the tokens in css/theme.css and the ui- components (docs/design-system.md).')
        sys.exit(1)

team_colors = Path('build/make_team_colors_css.py')
if team_colors.exists():
    result = subprocess.run(['python3', str(team_colors), '--check'])
    if result.returncode != 0:
        print('\nCommit aborted: css/team-colors.css no longer matches build/team-colors.json.')
        print('Run: python3 build/make_team_colors_css.py')
        sys.exit(1)

ui_icons = Path('build/make_ui_icons.py')
if ui_icons.exists():
    result = subprocess.run(['python3', str(ui_icons), '--check'])
    if result.returncode != 0:
        print('\nCommit aborted: css/ui-icons.css no longer matches build/make_ui_icons.py.')
        print('Run: python3 build/make_ui_icons.py')
        sys.exit(1)

vpath = Path('version.json')
cpath = Path('changelog.json')

staged = subprocess.run(
    ['git', 'diff', '--cached', '--name-only'],
    capture_output=True, text=True
).stdout.split()

changelog = json.loads(cpath.read_text()) if cpath.exists() else []
pending = [e for e in changelog if e.get('version') == 'pending']

if not pending:
    # Nothing user-facing shipped — a version with no changelog entry behind it
    # is worse than no version at all.
    sys.exit(0)


def version_json_changed():
    """True only if the staged version.json actually differs from HEAD's.

    Staging it unchanged is an easy thing to do by accident, and it used to
    read as "the author set the version" when all it means is "the file is in
    the commit".
    """
    return subprocess.run(
        ['git', 'diff', '--cached', '--quiet', '--', 'version.json']
    ).returncode != 0


data = json.loads(vpath.read_text())
parts = data['version'].split('.')

if 'version.json' in staged and version_json_changed():
    # Manual minor/major bump — leave it alone
    pass
else:
    # A changelog-only commit still bumps: a pending entry is new by
    # definition (a retroactive fix edits an entry that already has its
    # version), and it is how a change made in nbn-api gets its version.
    # Skipping the bump here stamped the entry with the version already
    # shipped (0.14.22 twice, 2026-10-26).
    parts[2] = str(int(parts[2]) + 1)
    data['version'] = '.'.join(parts)
    vpath.write_text(json.dumps(data) + '\n')
    subprocess.run(['git', 'add', 'version.json'])

new_version = data['version']

# Swap the text in place. Re-serializing the whole list reflowed every
# one-line entry into eight lines (and ¥ into ¥) on each bump.
import re
text, n = re.subn(r'("version"\s*:\s*)"pending"', rf'\1"{new_version}"', cpath.read_text())
if n != len(pending):
    sys.exit(f'pre-commit: found {len(pending)} pending changelog entries but replaced {n}')
cpath.write_text(text)
subprocess.run(['git', 'add', 'changelog.json'])

sys.exit(0)
