#!/usr/bin/env python3
"""
Verify the data contract, then auto-bump patch version on every commit.

**Tracked in the repo, not in .git/hooks** — `.git/hooks` is not cloned, so a
dev checkout would silently get neither half of this: `main` would start
collecting `"version": "pending"` changelog entries and unverified data-contract
changes. Both checkouts point here with:

    git config core.hooksPath build/hooks

Note that setting `core.hooksPath` replaces the hooks directory wholesale, so
any other hook has to live here too rather than in `.git/hooks`.

- Run build/smoke_test.py; abort the commit if a page reads a column or file
  that no longer exists, or if the rulebook's 🔒/👁 enforcement badges have
  drifted from what nbn-api's validators actually check
  (build/check_rulebook_badges.py --fix rewrites them). Bypass with
  `git commit --no-verify` if needed.
- Run build/test_build_sh.py; abort if build.sh has stopped defaulting to the
  Python stats engine, or grown a second copy of the season rule.
- Run build/test_validate_boxscore.py; abort if the box score validator has
  stopped catching a moved column or a TOTALS mismatch. Those two failures put
  plausible numbers in the wrong fields of an append-only file, so nothing
  downstream would ever report them.
- Run build/og_tags.py --check; abort if any page has missing or stale link-preview
  tags. New pages are the case this catches: without it they ship with no Discord
  unfurl and nothing says so.
- Regenerate skills/manifest.json from .claude/commands/*.md and stage it, so
  skills/index.html never needs a hand-maintained list of which commands exist.
- If no changelog entry is pending, nothing user-facing shipped: skip the bump
  entirely. A docs-only commit used to advertise a version /changelog had no
  entry for.
- If version.json is staged AND differs from HEAD (a real manual minor/major
  bump), leave it alone. Staged-but-unchanged is not a manual bump — treating it
  as one stamped the new entry with the version that already shipped, and the
  changelog came out with two 0.1.81 entries.
- If the only staged file is changelog.json (retroactive fix), skip the bump.
- Otherwise, increment the patch digit and stage version.json.
- Fill in *every* pending entry, not just the top one. A commit that adds two
  entries used to leave the second "pending" forever; five entries were stuck
  that way before this was fixed.
"""
import json, subprocess, sys
from pathlib import Path

smoke = Path('build/smoke_test.py')
if smoke.exists():
    result = subprocess.run(['python3', str(smoke), '--quiet'])
    if result.returncode != 0:
        print('\nCommit aborted: the data contract is broken (see FAIL lines above).')
        print('Fix the mismatch, or bypass with: git commit --no-verify')
        sys.exit(1)

build_sh_test = Path('build/test_build_sh.py')
if build_sh_test.exists():
    result = subprocess.run(['python3', str(build_sh_test)])
    if result.returncode != 0:
        print('\nCommit aborted: build.sh no longer holds its contract (see FAIL lines above).')
        print('Fix it, or bypass with: git commit --no-verify')
        sys.exit(1)

box_test = Path('build/test_validate_boxscore.py')
if box_test.exists():
    result = subprocess.run(['python3', str(box_test)])
    if result.returncode != 0:
        print('\nCommit aborted: the box score validator no longer catches what it must.')
        print('Fix build/validate_boxscore.py, or bypass with: git commit --no-verify')
        sys.exit(1)

og_tags = Path('build/og_tags.py')
if og_tags.exists():
    result = subprocess.run(['python3', str(og_tags), '--check'])
    if result.returncode != 0:
        print('\nCommit aborted: link-preview tags are missing or stale.')
        print('Add the page to PAGES in build/og_tags.py, then run: python3 build/og_tags.py')
        sys.exit(1)

skills_manifest = Path('build/gen_skills_manifest.py')
if skills_manifest.exists():
    subprocess.run(['python3', str(skills_manifest)])
    subprocess.run(['git', 'add', 'skills/manifest.json'])

vpath = Path('version.json')
cpath = Path('changelog.json')

staged = subprocess.run(
    ['git', 'diff', '--cached', '--name-only'],
    capture_output=True, text=True
).stdout.split()

changelog = json.loads(cpath.read_text()) if cpath.exists() else []
pending = [e for e in changelog if e.get('version') == 'pending']

if not pending:
    # Nothing user-facing shipped — a version with no changelog entry behind it
    # is worse than no version at all.
    sys.exit(0)


def version_json_changed():
    """True only if the staged version.json actually differs from HEAD's.

    Staging it unchanged is an easy thing to do by accident, and it used to
    read as "the author set the version" when all it means is "the file is in
    the commit".
    """
    return subprocess.run(
        ['git', 'diff', '--cached', '--quiet', '--', 'version.json']
    ).returncode != 0


data = json.loads(vpath.read_text())
parts = data['version'].split('.')

if 'version.json' in staged and version_json_changed():
    # Manual minor/major bump — leave it alone
    pass
elif staged == ['changelog.json']:
    # Retroactive changelog fix — don't bump
    pass
else:
    parts[2] = str(int(parts[2]) + 1)
    data['version'] = '.'.join(parts)
    vpath.write_text(json.dumps(data) + '\n')
    subprocess.run(['git', 'add', 'version.json'])

new_version = data['version']

for entry in pending:
    entry['version'] = new_version
cpath.write_text(json.dumps(changelog, indent=2) + '\n')
subprocess.run(['git', 'add', 'changelog.json'])

sys.exit(0)
